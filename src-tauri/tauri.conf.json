{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "peak",
  "version": "0.1.1",
  "identifier": "dev.peak.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "peak",
        "width": 1360,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Process monitor and memory profiler",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBODA0RTdFMkEzM0VENUYKUldSZjdUTXFmazZBT25yaUNOcEJVeWhaaVI1TEdwWkVhZkpWcnZ1ZmN0YzBSeWNDR1RGbDJwcisK",
      "endpoints": [
        "https://github.com/Noah-Wilderom/peak/releases/latest/download/latest.json"
      ]
    }
  }
}
